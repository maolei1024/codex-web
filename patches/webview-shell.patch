+      /*
+        codex-web mobile fixes. The app stylesheet sizes #root and body with
+        100vh, which overflows mobile browsers whenever the URL bar is
+        visible and leaves the composer's bottom action bar below the
+        screen. Track the visible height instead: the visualViewport
+        variable (kept current by the preload shim, see
+        src/browser/mobile-viewport.ts) reaches far older engines than dvh,
+        dvh covers non-touch layouts, and 100% is the last resort — which is
+        why body must be pinned back to 100%, or the 100% fallback resolves
+        against body's own 100vh.
+      */
+      html body {
+        height: 100%;
+      }
+      html #root {
+        height: 100%;
+        height: 100dvh;
+        height: var(--codex-web-visual-viewport-height, 100dvh);
+      }
+
+      /* The app shell wrapper carries an inline
+         height: calc(100vh / var(--codex-window-zoom)) — correct in a
+         fixed-size Electron window, but several Android browsers resolve
+         100vh against the large viewport (ignoring their own extra
+         toolbars), which pushes the composer's action bar below the screen
+         even when #root is pinned correctly. Re-base it on #root, keeping
+         the window-zoom division. */
+      html #root > div[style*="100vh"] {
+        height: calc(100% / var(--codex-window-zoom, 1)) !important;
+      }
+
