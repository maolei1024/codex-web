#!/bin/sh
set -eu
tools_root=${CODEX_TOOLS_ROOT:-/data/tools}
. "$tools_root/env.sh"
tool=${0##*/}
case "$tool" in
  python|python3|pip|pip3)
    python_env=${VIRTUAL_ENV:-$tools_root/python/venv}
    case "$tool" in
      pip|pip3) exec "$python_env/bin/python" -m pip "$@" ;;
      *) exec "$python_env/bin/python" "$@" ;;
    esac ;;
  with-java)
    case "${1-}" in
      8|24|25) JAVA_HOME="$tools_root/java/$1"; shift ;;
      *) echo 'Usage: with-java 8|24|25 command [args...]' >&2; exit 2 ;;
    esac
    [ "$#" -gt 0 ] || { echo 'with-java requires a command' >&2; exit 2; }
    export JAVA_HOME
    export PATH="$JAVA_HOME/bin:$PATH"
    exec "$@" ;;
  java8|java24|java25|javac8|javac24|javac25)
    version=${tool#java}; version=${version#c}
    case "$tool" in javac*) executable=javac ;; *) executable=java ;; esac
    exec "$tools_root/java/$version/bin/$executable" "$@" ;;
  java|javac|jar|javadoc|jshell|jlink|jpackage|keytool)
    exec "$JAVA_HOME/bin/$tool" "$@" ;;
  mvn) exec "$tools_root/maven/current/bin/mvn" "$@" ;;
  curl|jq|zip|unzip)
    # Keep the private Debian libraries out of Node, Codex and user programs.
    export LD_LIBRARY_PATH="$tools_root/system/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    exec "$tools_root/system/usr/bin/$tool" "$@" ;;
  *) echo "Unknown persistent tool: $tool" >&2; exit 2 ;;
esac
